{
  "name": "veetee-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Vietnamese-first realtime voice platform monorepo",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "workspaces": [
    "apps/control-api",
    "apps/web",
    "apps/simulator",
    "packages/protocol-contracts",
    "packages/db",
    "packages/config",
    "packages/testkit",
    "tools/device-simulator"
  ],
  "scripts": {
    "lint:root": "eslint eslint.config.mjs scripts",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "lint:python": "uv run --locked --no-sync --project apps/realtime ruff check apps/realtime",
    "lint": "npm run lint:root && npm run lint:workspaces && npm run lint:python",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "typecheck:python": "uv run --locked --no-sync --project apps/realtime mypy --config-file apps/realtime/pyproject.toml apps/realtime/app apps/realtime/tests",
    "typecheck": "npm run typecheck:workspaces && npm run typecheck:python",
    "test:guards": "node --test scripts/repository-check.test.mjs",
    "test:workspaces": "npm run test --workspaces --if-present",
    "test:python": "uv run --locked --no-sync --project apps/realtime pytest apps/realtime/tests",
    "test": "npm run test:guards && npm run test:workspaces && npm run test:python",
    "build": "npm run build --workspaces --if-present",
    "check:branding": "node scripts/repository-check.mjs branding",
    "check:secrets": "node scripts/repository-check.mjs secrets",
    "check:references": "node scripts/repository-check.mjs references",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:branding && npm run check:secrets && npm run check:references"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.35.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
