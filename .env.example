NODE_ENV=development
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3000
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8000

# Compose rejects empty datastore passwords. Set unique local values before use.
POSTGRES_DB=veetee
POSTGRES_USER=veetee
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=postgresql://veetee:replace-with-postgres-password@localhost:5432/veetee

REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_URL=redis://:replace-with-redis-password@localhost:6379/0

SECRET_ENCRYPTION_KEY=replace-with-generated-encryption-key
DEVICE_TOKEN_SIGNING_KEY=replace-with-generated-signing-key
PROVIDER_API_KEY=replace-with-provider-key
